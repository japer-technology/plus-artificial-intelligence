    {
      "op": "move",
      "anchor": ".hero-head",
      "target": ".hero-subtitle"
    },
    {
      "op": "insertBefore",
      "anchor": ".plain-meaning",
      "html": "<div class=\"seigaiha\" aria-hidden=\"true\"></div>"
    },
    {
      "op": "text",
      "anchor": "#specTitle",
      "html": "<span class=\"spec-mark\">+AI</span><span data-text=\"specification\">{{flavour:specification}}</span>"
    },
    {
      "op": "insertAfter",
      "anchor": "#top",
      "html": "<div class=\"seigaiha\" aria-hidden=\"true\"></div>"
    }
  ]
