    {
      "op": "insertAfter",
      "anchor": ".wordmark",
      "html": "<div class=\"permit-block\" aria-hidden=\"true\"><span class=\"permit-no\">{{flavour:permit-no}}+AI-0.1</span><span><span data-text=\"statusLabel\">{{flavour:status}}</span>:<span data-text=\"statusValue\">{{flavour:draft}}</span></span></div>"
    },
    {
      "op": "prependTo",
      "anchor": "#meaning",
      "html": "<div class=\"scaffold\" aria-hidden=\"true\"></div>"
    },
    {
      "op": "prependTo",
      "anchor": ".hero-copy",
      "html": "<span class=\"bolt bolt-tl\" aria-hidden=\"true\"></span><span class=\"bolt bolt-tr\" aria-hidden=\"true\"></span><span class=\"bolt bolt-bl\" aria-hidden=\"true\"></span><span class=\"bolt bolt-br\" aria-hidden=\"true\"></span>"
    },
    {
      "op": "prependTo",
      "anchor": ".meaning-card",
      "html": "<p class=\"card-tag\" aria-hidden=\"true\">{{flavour:site-notice}}</p>"
    }
  ]
