      "html": "<div class=\"ticker\" aria-hidden=\"true\"><div class=\"ticker-track\"><div class=\"ticker-run\"><span class=\"tk-accent\">+AI 0.1</span><span class=\"tk-sep\">▲</span><span class=\"tk\">{{flavour:responsibility-100}}</span><span class=\"tk-sep\">·</span><span class=\"tk\">{{flavour:mark}}+AI</span><span class=\"tk-sep\">·</span><span class=\"tk\"><span data-text=\"statusLabel\">{{flavour:status}}</span><span data-text=\"statusValue\">{{flavour:draft}}</span></span><span class=\"tk-sep\">·</span><span class=\"tk\">{{flavour:human-accountability}}</span><span class=\"tk-sep\">·</span><span class=\"tk\">{{flavour:canonical}}+AI</span><span class=\"tk-sep\">▲</span></div><div class=\"ticker-run\"><span class=\"tk-accent\">+AI 0.1</span><span class=\"tk-sep\">▲</span><span class=\"tk\">{{flavour:flavour-1}}</span><span class=\"tk-sep\">·</span><span class=\"tk\">{{flavour:flavour-2}}+AI</span><span class=\"tk-sep\">·</span><span class=\"tk\"><span data-text=\"statusLabel\">{{flavour:flavour-3}}</span><span data-text=\"statusValue\">{{flavour:flavour-4}}</span></span><span class=\"tk-sep\">·</span><span class=\"tk\">{{flavour:flavour-5}}</span><span class=\"tk-sep\">·</span><span class=\"tk\">{{flavour:flavour-6}}+AI</span><span class=\"tk-sep\">▲</span></div></div></div>"
    }
  ]
