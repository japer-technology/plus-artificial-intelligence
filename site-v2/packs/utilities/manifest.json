{
  "packId": "utilities",
  "version": 1,
  "hash": "",
  "languages": [
    "*"
  ],
  "accessibility": {
    "contrast": "AA",
    "reducedMotion": true,
    "notes": "Migrated from the legacy utilities.html page; parity verified by build.mjs --verify-pack."
  },
  "conformanceChecked": "2026-09-05",
  "assets": [
    "theme.css",
    "flavour.json",
    "note.json"
  ],
  "name": {
    "en": "Utilities"
  },
  "maintainer": "JAPER Technology",
  "license": "Project contribution terms (docs/development/0007-licensing-and-mark-policy)",
  "tokens": {
    "accent": "#3DDC84",
    "font": "Inter",
    "fontStack": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Hebrew\", \"Noto Sans Bengali\", \"Noto Sans Gujarati\", \"Noto Sans Gurmukhi\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Kannada\", \"Noto Sans Malayalam\", \"Noto Sans Thai\", \"Noto Sans Ethiopic\", \"Noto Sans SC\", \"Noto Sans JP\", \"Noto Sans KR\", sans-serif",
    "fontOptions": [],
    "defaultMode": "dark",
    "onAccentDark": "#111013",
    "onAccentLight": "#FFFFFF",
    "onAccentThreshold": 0.179,
    "themeColor": "#3DDC84"
  },
  "decorations": [
    {
      "op": "insertBefore",
      "anchor": ".hero-copy",
      "html": "<div class=\"network\" aria-hidden=\"true\"></div>"
    },
    {
      "op": "setAttribute",
      "anchor": "#fontSelect",
      "name": "aria-label",
      "value": "Choose a font"
    },
    {
      "op": "wrap",
      "anchor": ".wordmark",
      "before": "<div class=\"ops-bar\">",
      "after": "</div>"
    },
    {
      "op": "insertAfter",
      "anchor": ".wordmark",
      "html": "<div class=\"ops-feed\"><span class=\"chip chip-stable\" aria-hidden=\"true\">{{flavour:stable}}</span> <span class=\"feed-line\">{{flavour:feed}} +AI-0.1 · <span data-text=\"statusLabel\">Status</span>: <span data-text=\"statusValue\">Draft</span></span></div>"
    },
    {
      "op": "move",
      "anchor": ".ops-bar",
      "target": ".header-controls"
    },
    {
      "op": "wrap",
      "anchor": ".meaning-card",
      "before": "<div class=\"hero-side\"><div class=\"gauge\" aria-hidden=\"true\"><div class=\"gauge-arc\"></div><div class=\"gauge-needle\"></div><div class=\"gauge-hub\"></div><div class=\"gauge-readout\"><span class=\"gauge-value\">100%</span> <span class=\"gauge-caption\">{{flavour:responsibility}}</span></div></div>",
      "after": "</div>"
    },
    {
      "op": "prependTo",
      "anchor": ".meaning-card",
      "html": "<p class=\"card-kicker\" aria-hidden=\"true\">{{flavour:service-guarantees}}</p>"
    },
    {
      "op": "insertBefore",
      "anchor": ".plain-meaning",
      "html": "<div class=\"network-strip\" aria-hidden=\"true\"></div>"
    },
    {
      "op": "wrap",
      "anchor": ".spec-meta",
      "before": "<div class=\"telemetry\"><p class=\"telemetry-kicker\" aria-hidden=\"true\">{{flavour:telemetry}}</p>",
      "after": "</div>"
    },
    {
      "op": "prependTo",
      "anchor": ".toc",
      "html": "<p class=\"toc-kicker\" aria-hidden=\"true\">{{flavour:network-map}}</p>"
    },
    {
      "op": "text",
      "anchor": "footer",
      "html": "<span class=\"footer-left\"><span class=\"status-dot\" aria-hidden=\"true\"></span> <span data-text=\"footerLine\">Open notation. Human responsibility.</span></span> <span>+AI · <span data-text=\"versionFooter\">Specification v0.1</span></span>"
    }
  ]
}
