  "name": {
    "en": "Realestate"
  },
  "maintainer": "JAPER Technology",
  "license": "Project contribution terms (docs/development/0007-licensing-and-mark-policy)",
  "tokens": {
    "accent": "#C0392B",
    "font": "Inter",
    "fontStack": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Hebrew\", \"Noto Sans Bengali\", \"Noto Sans Gujarati\", \"Noto Sans Gurmukhi\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Kannada\", \"Noto Sans Malayalam\", \"Noto Sans Thai\", \"Noto Sans Ethiopic\", \"Noto Sans SC\", \"Noto Sans JP\", \"Noto Sans KR\", sans-serif",
    "fontOptions": [],
    "defaultMode": "light",
    "onAccentDark": "#111013",
    "onAccentLight": "#FFFFFF",
    "onAccentThreshold": 0.179,
    "themeColor": "#C0392B"
  },
  "decorations": [
    {
      "op": "wrapInner",
      "anchor": ".site-header",
      "before": "<div class=\"header-bar\">",
      "after": "</div>"
    },
    {
      "op": "insertAfter",
      "anchor": ".wordmark",
      "html": "<p class=\"mls-line\"><span class=\"mls-id\">MLS# +AI-0.1</span><span class=\"mls-dot\" aria-hidden=\"true\">·</span><span class=\"mls-status\"><span data-text=\"statusLabel\">Status</span><span aria-hidden=\"true\">:</span><span data-text=\"statusValue\">Draft</span></span></p>"
    },
    {
      "op": "prependTo",
      "anchor": "#meaning",
      "html": "<span class=\"open-tag\" aria-hidden=\"true\">{{flavour:open}}</span>"
    },
    {
      "op": "insertAfter",
      "anchor": ".hero-lead",
      "html": "<dl class=\"facts-row\"><div class=\"fact\"><dt data-text=\"statusLabel\">Status</dt><dd data-text=\"statusValue\">Draft</dd></div><div class=\"fact\"><dt data-text=\"versionLabel\">Version</dt><dd>0.1</dd></div><div class=\"fact\"><dt data-text=\"markLabel\">Canonical mark</dt><dd><code>+AI</code></dd></div></dl>"
    },
    {
      "op": "insertAfter",
      "anchor": ".hero-copy",
      "html": "<div class=\"hero-side\"><div class=\"floor-plan\" aria-hidden=\"true\"><span class=\"fp-room fp-living\">{{flavour:living}}</span><span class=\"fp-room fp-kitchen\">{{flavour:kitchen}}</span><span class=\"fp-room fp-bath\">{{flavour:bath}}</span><span class=\"fp-room fp-bed\">{{flavour:bed}}</span><span class=\"fp-room fp-hall\">{{flavour:hall}}</span></div></div>"
    },
    {
      "op": "move",
      "anchor": ".hero-side",
      "target": ".meaning-card"
    }
  ]
}
