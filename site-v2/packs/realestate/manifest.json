    "contrast": "AA",
    "reducedMotion": true,
    "notes": "Migrated from the legacy realestate.html page; parity verified by build.mjs --verify-pack."
  },
  "conformanceChecked": "2026-09-05",
  "assets": [
    "theme.css",
    "flavour.json",
    "note.json"
