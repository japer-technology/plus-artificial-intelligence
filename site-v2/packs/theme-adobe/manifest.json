{
  "packId": "theme-adobe",
  "version": 1,
  "hash": "",
  "languages": [
    "*"
  ],
  "accessibility": {
    "contrast": "AA",
    "reducedMotion": true,
    "notes": "Migrated from the legacy theme-adobe.html page; parity verified by build.mjs --verify-pack."
  },
  "conformanceChecked": "2026-09-05",
  "assets": [
    "theme.css",
    "flavour.json",
    "note.json"
  ],
  "name": {
    "en": "Adobe"
  },
  "maintainer": "JAPER Technology",
  "license": "Project contribution terms (docs/development/0007-licensing-and-mark-policy)",
  "tokens": {
    "accent": "#FA0F00",
    "font": "Manrope",
    "fontStack": "Manrope, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Hebrew\", \"Noto Sans Bengali\", \"Noto Sans Gujarati\", \"Noto Sans Gurmukhi\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Kannada\", \"Noto Sans Malayalam\", \"Noto Sans Thai\", \"Noto Sans Ethiopic\", \"Noto Sans SC\", \"Noto Sans JP\", \"Noto Sans KR\", sans-serif",
    "fontOptions": [],
    "defaultMode": "dark",
    "onAccentDark": "#111013",
    "onAccentLight": "#FFFFFF",
    "onAccentThreshold": 0.179,
    "themeColor": "#FA0F00"
  },
  "decorations": [
    {
      "op": "prependTo",
      "anchor": "#meaning",
      "html": "<div class=\"artboard\" aria-hidden=\"true\"><div class=\"artboard-canvas\"><span class=\"artboard-label label-tl\">{{flavour:aa}}</span><span class=\"artboard-label label-tr\">+AI</span><span class=\"artboard-label label-bl\">0.1</span><span class=\"artboard-label label-br\">{{flavour:rgb}}</span><span class=\"artboard-mark\">+AI</span><span class=\"handle handle-tl\"></span><span class=\"handle handle-tr\"></span><span class=\"handle handle-bl\"></span><span class=\"handle handle-br\"></span></div></div>"
    },
    {
      "op": "insertAfter",
      "anchor": ".artboard",
      "html": "<div class=\"hero-grid\"></div>"
    },
    {
      "op": "move",
      "anchor": ".hero-grid",
      "target": ".hero-copy"
    },
    {
      "op": "move",
      "anchor": ".hero-grid",
      "target": ".meaning-card"
    },
    {
      "op": "prependTo",
      "anchor": ".meaning-card",
      "html": "<span class=\"panel-bar\" aria-hidden=\"true\">{{flavour:properties}}</span>"
    },
    {
      "op": "prependTo",
      "anchor": ".toc",
      "html": "<span class=\"panel-bar\" aria-hidden=\"true\">{{flavour:pages}}</span>"
    }
  ]
}
