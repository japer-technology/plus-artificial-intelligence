  "decorations": [
    {
      "op": "appendTo",
      "anchor": ".wordmark",
      "html": "<span class=\"wordmark-dot\" aria-hidden=\"true\"></span>"
    },
    {
      "op": "insertAfter",
      "anchor": ".site-header",
      "html": "<div class=\"ticker\" aria-hidden=\"true\"><div class=\"ticker-track\"><div class=\"ticker-group\"><span class=\"ticker-item\">+AI 0.1</span><span class=\"ticker-arrow\">▲</span><span class=\"ticker-dot\">·</span><span class=\"ticker-item\">{{flavour:responsibility-100}}</span><span class=\"ticker-dot\">·</span><span class=\"ticker-item\">{{flavour:mark}}+AI</span><span class=\"ticker-dot\">·</span><span class=\"ticker-item ticker-status\" data-text=\"statusValue\">{{flavour:draft}}</span></div><div class=\"ticker-group\"><span class=\"ticker-item\">+AI 0.1</span><span class=\"ticker-arrow\">▲</span><span class=\"ticker-dot\">·</span><span class=\"ticker-item\">{{flavour:flavour-1}}</span><span class=\"ticker-dot\">·</span><span class=\"ticker-item\">{{flavour:flavour-2}}+AI</span><span class=\"ticker-dot\">·</span><span class=\"ticker-item ticker-status\" data-text=\"statusValue\">{{flavour:flavour-3}}</span></div></div></div>"
    },
    {
      "op": "insertAfter",
      "anchor": ".primary-link",
      "html": "<span class=\"status-chip\" aria-hidden=\"true\">{{flavour:settled}}</span>"
    },
    {
      "op": "prependTo",
      "anchor": ".meaning-card",
      "html": "<span class=\"panel-label\" aria-hidden=\"true\">{{flavour:the-stack}}</span>"
    },
    {
      "op": "wrap",
      "anchor": ".spec-meta",
      "before": "<div class=\"spec-header-meta\"><span class=\"status-chip\" aria-hidden=\"true\">{{flavour:confirmed}}</span>",
      "after": "</div>"
    },
    {
      "op": "prependTo",
      "anchor": ".toc",
      "html": "<span class=\"panel-label\" aria-hidden=\"true\">{{flavour:products}}</span>"
    }
  ]
}
